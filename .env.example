# ============================================================================
# OneGate 环境变量示例模板 (复制为 .env 后按需修改，切勿将真实密钥提交至 Git)
# ============================================================================

# --- 网关安全与运行模式 ---
# 管理端接口 /admin/** 必填鉴权令牌 (生产环境务必设置为高强度随机密钥)
ONEGATE_ADMIN_TOKEN=replace-with-strong-admin-token
# 是否启用内置 /mock-llm/** 仿真上游 (生产建议 false，本地联调设为 true)
ONEGATE_MOCK_ENABLED=false
# 允许跨域的 Origin Pattern 列表 (逗号分隔)
ONEGATE_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# --- MySQL 8.0 / 9.0 ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/one_gate?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
MYSQL_DATABASE=one_gate
MYSQL_ROOT_PASSWORD=
MYSQL_ALLOW_EMPTY_PASSWORD=yes

# --- Redis 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- RabbitMQ 3.12 ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- 真实上游大模型测试密钥 (仅在运行真实联调测试时注入) ---
DASHSCOPE_API_KEY=
